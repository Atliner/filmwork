# Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://stream.example.com
CORS_ORIGINS=https://stream.example.com
TRUST_PROXY=1

# MySQL (create a utf8mb4 database and least-privilege user in cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_filmwork
DB_USER=cpaneluser_filmwork
DB_PASSWORD=replace-with-a-long-random-password
DB_CONNECTION_LIMIT=10

# Generate each value independently with: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters
AUTH_CODE_PEPPER=replace-with-64-random-hex-characters
PHONE_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Public login/delivery bot (add it as an administrator in every storage channel)
AUTH_BOT_TOKEN=123456789:replace-with-token-from-botfather
AUTH_BOT_USERNAME=your_public_login_bot

# Separate private owner/admin bot. Never reuse the public bot token.
ADMIN_BOT_TOKEN=987654321:replace-with-private-token-from-botfather
ADMIN_BOT_USERNAME=your_private_owner_bot
ADMIN_OWNER_IDS=123456789

# Telegram storage. IDs normally begin with -100. The admin bot must be an
# administrator in all three channels; the auth bot needs copy-message access.
ADMIN_SOURCE_CHAT_ID=-1001111111111
TELEGRAM_PRIMARY_CHAT_ID=-1001111111111
TELEGRAM_FALLBACK_1_CHAT_ID=-1002222222222
TELEGRAM_FALLBACK_2_CHAT_ID=-1003333333333
# Optional public usernames (without @). Leave blank for private /c/ links.
TELEGRAM_PRIMARY_USERNAME=
TELEGRAM_FALLBACK_1_USERNAME=
TELEGRAM_FALLBACK_2_USERNAME=

# Uploads and link validation
MAX_UPLOAD_MB=25
TELEGRAM_LINK_CHECK_TIMEOUT_MS=5000
AUTH_CODE_TTL_MINUTES=5
JWT_TTL=7d
ADMIN_SESSION_TTL=2h

# Owner console preview (development only). 1 = in-memory store, no MySQL needed.
# MUST be 0 (or unset) on any real deployment: data would be lost on restart.
DEMO_DATA=0
# Updating the host from GitHub without File Manager (see DEPLOYMENT_GUIDE.md §11).
GITHUB_REPO=Atliner/filmwork
GITHUB_BRANCH=main
# Only for a private repository; a fine-grained token with read-only Contents access.
GITHUB_TOKEN=

# Startup hardening (optional)
# Seconds between background retries after a failed startup / Telegram bot start.
BOOT_RETRY_SECONDS=15
BOT_RETRY_SECONDS=300
