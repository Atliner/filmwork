{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vizosten",
  "version": "1.2.0",
  "identifier": "ir.namdarcompost.filmwork",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Vizosten | ویزوستن",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Vizosten movie and series platform",
    "category": "Video",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
