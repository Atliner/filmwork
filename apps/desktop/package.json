{
  "name": "filmwork-desktop",
  "version": "1.0.0",
  "description": "Filmwork desktop web application",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "com.filmwork.desktop",
    "productName": "Filmwork",
    "directories": { "output": "dist" },
    "files": ["main.js", "app-config.json", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "Filmwork-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
